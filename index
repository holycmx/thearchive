// AUTO-DATE TRIGGER FOR SCREEN TIME
// ═══════════════════════════════════════════════════════════════════
function autoFillScreenTimeDate(e) {
  const sheet = e.range.getSheet();
  if (sheet.getName() !== 'Screen Time') return;

  const row = e.range.getRow();
  const col = e.range.getColumn();
  if (row < 3) return;

  // Daily log: cols B–D (2–4) → auto-fill date in A (1)
  if (col >= 2 && col <= 4) {
    const dateCell = sheet.getRange(row, 1);
    if (dateCell.getValue() === '') {
      dateCell.setValue(new Date()).setNumberFormat('dd/mm/yyyy');
    }
    // Auto-sort daily log by date
    const lastRow = sheet.getLastRow();
    if (lastRow > 3) {
      sheet.getRange(3, 1, lastRow - 2, 6)
        .sort({ column: 1, ascending: true });
    }
  }

  // Weekly app log: cols I–K (9–11) → auto-fill week starting in H (8)
  if (col >= 9 && col <= 11) {
    const weekCell = sheet.getRange(row, 8);
    if (weekCell.getValue() === '') {
      // Set to Monday of current week
      const today = new Date();
      const day = today.getDay();
      const monday = new Date(today);
      monday.setDate(today.getDate() - ((day + 6) % 7));
      monday.setHours(0, 0, 0, 0);
      weekCell.setValue(monday).setNumberFormat('dd/mm/yyyy');
    }
  }
}


