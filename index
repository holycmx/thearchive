  sheet.getRange(3, 2, dataRows, 4).setNumberFormat('0.0');

  // ── DAILY DATA VALIDATION ────────────────────────────────────────

  // B–D: hours >= 0
  const rule_hrs = SpreadsheetApp.newDataValidation()
