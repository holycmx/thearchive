// ═══════════════════════════════════════════════════════════════════
// AUTO-DATE + AUTO-SORT + AUTO-PAYMENT TRIGGER
// ═══════════════════════════════════════════════════════════════════
function autoFillMoneyDate(e) {
  const sheet = e.range.getSheet();
  if (sheet.getName() !== 'Money') return;

  const row = e.range.getRow();
  const col = e.range.getColumn();
  if (row < 3) return;

  // ── Auto-date: Income cols H–J (8–10) → date in G (7) ───────────
  if (col >= 8 && col <= 10) {
    const dc = sheet.getRange(row, 7);
    if (dc.getValue() === '') {
      dc.setValue(new Date()).setNumberFormat('dd/mm/yyyy');
    }
  }

  // ── Auto-date: Spending cols M–R (13–18) → date in L (12) ───────
  if (col >= 13 && col <= 18) {
    const dc = sheet.getRange(row, 12);
    if (dc.getValue() === '') {
      dc.setValue(new Date()).setNumberFormat('dd/mm/yyyy');
    }

    // ── Auto-payment: Transport → Card ──────────────────────────────
    if (col === 14) { // Category column N
      const category = sheet.getRange(row, 14).getValue();
      const paymentCell = sheet.getRange(row, 17); // Q = Payment
      if (category === 'Transport' && paymentCell.getValue() === '') {
        paymentCell.setValue('Card');
      }
      // Cash Withdrawal → Card (you used your debit card at ATM)
      if (category === 'Cash Withdrawal' && paymentCell.getValue() === '') {
        paymentCell.setValue('Card');
      }
    }
  }

  // ── Auto-date: Deposit log cols AB–AD (28–30) → date in AA (27) ─
  if (col >= 28 && col <= 30) {
    const dc = sheet.getRange(row, 27);
    if (dc.getValue() === '') {
      dc.setValue(new Date()).setNumberFormat('dd/mm/yyyy');
    }
  }

  // ── Auto-sort: sort income log by date after any edit ────────────
  if (col >= 7 && col <= 10) {
    const lastIncomeRow = sheet.getLastRow();
    if (lastIncomeRow > 3) {
      sheet.getRange(3, 7, lastIncomeRow - 2, 4)
        .sort({ column: 7, ascending: true });
    }
  }

  // ── Auto-sort: sort spending log by date after any edit ──────────
  if (col >= 12 && col <= 18) {
    const lastSpendRow = sheet.getLastRow();
    if (lastSpendRow > 3) {
      sheet.getRange(3, 12, lastSpendRow - 2, 7)
        .sort({ column: 12, ascending: true });
    }
  }
}

