function installAllTriggers() {
  const ss = SpreadsheetApp.openById('16G7tuwU6HJpbhS1AIjkRLiO2jEcj3oaV3KKCHypU3RY');
  const fns = [
    'autoFillDate',
    'autoFillHealthDate',
    'autoFillMoneyDate',
    'autoFillLifeAndCultureDate',
    'autoFillScreenTimeDate',
  ];
  fns.forEach(fn => {
    ScriptApp.getProjectTriggers().forEach(t => {
      if (t.getHandlerFunction() === fn) ScriptApp.deleteTrigger(t);
    });
    ScriptApp.newTrigger(fn).forSpreadsheet(ss).onEdit().create();
  });
  Logger.log('✅ All triggers installed.');
}


function hexToColor(hex) {
  hex = hex.replace('#', '');
  return {
    red:   parseInt(hex.substring(0,2),16)/255,
    green: parseInt(hex.substring(2,4),16)/255,
    blue:  parseInt(hex.substring(4,6),16)/255
  };
}
