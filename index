  const sheetId = sheet.getSheetId();
  const cfDailyEnd = 3 + dataRows;
  const cfAppEnd = 3 + appRows;

  Sheets.Spreadsheets.batchUpdate({ requests: [

    // Daily total E (col 4): green=low, red=high
    { addConditionalFormatRule: { rule: {
      ranges: [{ sheetId, startRowIndex: 2, endRowIndex: cfDailyEnd,
                 startColumnIndex: 4, endColumnIndex: 5 }],
      gradientRule: {
        minpoint: { color: hexToColor('C8E6C9'), type: 'NUMBER', value: '0' },
        midpoint: { color: hexToColor('FFF9C4'), type: 'NUMBER', value: '6' },
        maxpoint: { color: hexToColor('B71C1C'), type: 'NUMBER', value: '12' }
      }
    }, index: 0 } },

    // iPhone B (col 1) gradient
