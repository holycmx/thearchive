function buildMoneyTab() {
  const ss = SpreadsheetApp.openById('16G7tuwU6HJpbhS1AIjkRLiO2jEcj3oaV3KKCHypU3RY');

  const existing = ss.getSheetByName('Money');
  if (existing) ss.deleteSheet(existing);
  const sheet = ss.insertSheet('Money');
  sheet.setTabColor('#8B6914');

  const currentCols = sheet.getMaxColumns();
  if (currentCols < 40) sheet.insertColumnsAfter(currentCols, 40 - currentCols);

  // ── Palette ──────────────────────────────────────────────────────
  const DARK   = '#3B2800';
  const MID    = '#8B6914';
  const SOFT   = '#B8860B';
  const ACCENT = '#F5E6C8';
  const PALE   = '#FDF6E3';
  const CREAM  = '#FFFBF0';
  const WHITE  = '#FFFFFF';
  const GREEN  = '#1B5E20';
  const GREENBG= '#C8E6C9';
  const RED    = '#B71C1C';
  const REDBG  = '#FFCDD2';

  // ── Column layout ────────────────────────────────────────────────
  // A–E: Summary + Codex | F: gap
  // G–J: Income | K: gap
  // L–R: Spending | S: gap
  // T–Y: Savings tracker (rows 3–9) + Cash Tracker (rows 13+) | Z: gap
  // AA–AD: Deposit log
  const colWidths = [
    130, 100, 130, 100, 100, 25,   // A–F
    110, 100, 140, 200, 25,         // G–K
    110, 100, 140, 200, 130, 110, 80, 25, // L–S
    160, 100, 100, 100, 70, 140, 25,      // T–Z
    110, 160, 100, 200,             // AA–AD
  ];
  colWidths.forEach((w, i) => sheet.setColumnWidth(i + 1, w));

  sheet.getRange(1, 1, 1200, 30)
    .setFontFamily('Arial').setFontSize(10).setVerticalAlignment('middle');

  // ═══════════════════════════════════════════════════════════════
  // ROW 1: SECTION TITLE BANNERS
  // ═══════════════════════════════════════════════════════════════
  sheet.setRowHeight(1, 45);
  sheet.getRange(1, 1, 1, 5).merge()
    .setValue('💰 MONEY').setBackground(DARK).setFontColor(WHITE)
    .setFontSize(18).setFontWeight('bold')
    .setHorizontalAlignment('center').setVerticalAlignment('middle');
  sheet.getRange(1, 7, 1, 4).merge()
    .setValue('INCOME LOG').setBackground(DARK).setFontColor(WHITE)
    .setFontSize(13).setFontWeight('bold')
    .setHorizontalAlignment('center').setVerticalAlignment('middle');
  sheet.getRange(1, 12, 1, 7).merge()
    .setValue('SPENDING LOG').setBackground(DARK).setFontColor(WHITE)
    .setFontSize(13).setFontWeight('bold')
    .setHorizontalAlignment('center').setVerticalAlignment('middle');
  sheet.getRange(1, 20, 1, 6).merge()
    .setValue('SAVINGS & CASH TRACKER').setBackground(DARK).setFontColor(WHITE)
    .setFontSize(13).setFontWeight('bold')
    .setHorizontalAlignment('center').setVerticalAlignment('middle');
  sheet.getRange(1, 27, 1, 4).merge()
    .setValue('DEPOSIT LOG').setBackground(DARK).setFontColor(WHITE)
    .setFontSize(13).setFontWeight('bold')
    .setHorizontalAlignment('center').setVerticalAlignment('middle');

  // ═══════════════════════════════════════════════════════════════
  // ROW 2: COLUMN HEADERS + MONTH SELECTOR — FREEZE THIS ROW
  // ═══════════════════════════════════════════════════════════════
  sheet.setRowHeight(2, 36);

  // Month selector A–C
  sheet.getRange(2, 1, 1, 3).merge()
    .setValue('VIEWING MONTH:').setBackground(MID).setFontColor(WHITE)
    .setFontSize(10).setFontWeight('bold')
    .setHorizontalAlignment('right').setVerticalAlignment('middle');

  // D2: selector — plain text format
  sheet.getRange(2, 4, 1, 2).merge()
    .setNumberFormat('@').setValue('May 2026')
    .setBackground(ACCENT).setFontColor(DARK)
    .setFontSize(11).setFontWeight('bold')
    .setHorizontalAlignment('center').setVerticalAlignment('middle');

  sheet.getRange(2, 4).setDataValidation(
    SpreadsheetApp.newDataValidation()
      .requireValueInList(['May 2026','Jun 2026','Jul 2026','Aug 2026'], true)
      .setAllowInvalid(false).build()
  );

  // Hidden helpers K1=month start, K2=month end
  sheet.getRange(1, 11)
    .setFormula('=DATE(VALUE(RIGHT(D2,4)),MATCH(LEFT(D2,3),{"Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"},0),1)')
    .setNumberFormat('dd/mm/yyyy')
    .setFontColor('#F6F0E4').setBackground('#F6F0E4');
  sheet.getRange(2, 11)
    .setFormula('=EOMONTH(K1,0)')
    .setNumberFormat('dd/mm/yyyy')
    .setFontColor('#F6F0E4').setBackground('#F6F0E4');

  // Income headers G–J
  sheet.getRange(2, 7, 1, 4)
    .setValues([['Date','Amount (£)','Source','Description']])
    .setBackground(MID).setFontColor(WHITE)
    .setFontSize(10).setFontWeight('bold')
    .setHorizontalAlignment('center').setVerticalAlignment('middle');

  // Spending headers L–R
  sheet.getRange(2, 12, 1, 7)
    .setValues([['Date','Amount (£)','Category','Description',
                 'Necessity','Payment','Mood\n(1–10)']])
    .setBackground(MID).setFontColor(WHITE)
    .setFontSize(10).setFontWeight('bold')
    .setHorizontalAlignment('center').setVerticalAlignment('middle')
    .setWrap(true);

  // Savings headers T–Y
  sheet.getRange(2, 20, 1, 6)
    .setValues([['Savings Pot','Target (£)','Saved (£)',
                 'Remaining','% Done','Progress']])
    .setBackground(SOFT).setFontColor(WHITE)
    .setFontSize(10).setFontWeight('bold')
    .setHorizontalAlignment('center').setVerticalAlignment('middle');

  // Deposit log headers AA–AD
  sheet.getRange(2, 27, 1, 4)
    .setValues([['Date','Pot','Amount (£)','Description']])
    .setBackground(SOFT).setFontColor(WHITE)
    .setFontSize(10).setFontWeight('bold')
    .setHorizontalAlignment('center').setVerticalAlignment('middle');

  sheet.setFrozenRows(2);

  // ═══════════════════════════════════════════════════════════════
  // MONTHLY SUMMARY — Rows 3–18, Columns A–E
  // K1 = month start, K2 = month end
  // Income: date=G(7), amount=H(8)
  // Spending: date=L(12), amount=M(13), category=N(14), necessity=P(16)
  // Cash Withdrawals excluded from Total Spent
  // Fixed costs: Phone £10 + Gym £26.95 + StepChange £170 = £206.95
  // ═══════════════════════════════════════════════════════════════
  const mS = '$K$1';
  const mE = '$K$2';

  function sRow(row, label, formula, lBg, vBg, lFc, vFc, vSize, bold) {
    sheet.setRowHeight(row, 28);
    sheet.getRange(row, 1, 1, 3).clearContent().clearFormat();
    sheet.getRange(row, 4, 1, 2).clearContent().clearFormat();
    sheet.getRange(row, 1, 1, 3).merge()
      .setValue(label)
      .setBackground(lBg || ACCENT).setFontColor(lFc || DARK)
      .setFontFamily('Arial').setFontSize(10)
      .setFontWeight(bold ? 'bold' : 'normal')
      .setHorizontalAlignment('right').setVerticalAlignment('middle');
    const v = sheet.getRange(row, 4, 1, 2).merge();
    formula ? v.setFormula(formula) : v.setValue(0);
    v.setBackground(vBg || PALE).setFontColor(vFc || DARK)
      .setFontFamily('Arial').setFontSize(vSize || 12)
      .setFontWeight(bold ? 'bold' : 'normal')
      .setNumberFormat('£#,##0.00')
      .setHorizontalAlignment('left').setVerticalAlignment('middle');
  }

  function divRow(row) {
    sheet.setRowHeight(row, 6);
    sheet.getRange(row, 1, 1, 5).clearContent().clearFormat()
      .setBackground(ACCENT);
  }

  function totalRow(row, label, formula, lBg, vBg) {
    sheet.setRowHeight(row, 32);
    // Clear first to prevent formula parse errors from stale content
    sheet.getRange(row, 1, 1, 5).clearContent().clearFormat();
    SpreadsheetApp.flush();
    sheet.getRange(row, 1, 1, 3).merge()
      .setValue(label)
      .setBackground(lBg).setFontColor(WHITE)
      .setFontFamily('Arial').setFontSize(10).setFontWeight('bold')
      .setHorizontalAlignment('right').setVerticalAlignment('middle');
    sheet.getRange(row, 4, 1, 2).merge()
      .setFormula(formula)
      .setBackground(vBg).setFontColor(WHITE)
      .setFontFamily('Arial').setFontSize(15).setFontWeight('bold')
      .setNumberFormat('£#,##0.00')
      .setHorizontalAlignment('left').setVerticalAlignment('middle');
  }

  // Row 3: header
  sheet.setRowHeight(3, 28);
  sheet.getRange(3, 1, 1, 5).clearContent().clearFormat();
  sheet.getRange(3, 1, 1, 5).merge()
    .setValue('MONTHLY SUMMARY').setBackground(DARK).setFontColor(WHITE)
    .setFontSize(11).setFontWeight('bold')
    .setHorizontalAlignment('center').setVerticalAlignment('middle');

  // Row 4: Gross Income
  sRow(4, 'Gross Income',
    `=IFERROR(SUMIFS(H3:H,G3:G,">="&${mS},G3:G,"<="&${mE}),0)`,
    ACCENT, GREENBG, DARK, GREEN, 13, true);

  // Row 5: Total Saved
  sRow(5, '− Total Saved (all pots)',
    '=IFERROR(SUM(AC3:AC),0)',
    ACCENT, PALE, DARK, RED, 12, false);

  // Row 6: Net Spendable
  totalRow(6, '= Net Spendable', '=D4-D5', MID, SOFT);

  divRow(7);

  // Row 8: Spending Limit 50%
  sRow(8, 'Spending Limit (50%)',
    `=IFERROR(SUMIFS(H3:H,G3:G,">="&${mS},G3:G,"<="&${mE})*0.5,0)`,
    ACCENT, PALE, DARK, MID, 13, true);

  // Row 9: Fixed Costs (Phone £10 + Gym £26.95 + StepChange £170 = £206.95)
  sRow(9, 'Fixed Costs',
    `=IFERROR(206.95` +
    `+SUMIFS(M3:M,N3:N,"Gas & Electric",L3:L,">="&${mS},L3:L,"<="&${mE})` +
    `+SUMIFS(M3:M,N3:N,"Family",L3:L,">="&${mS},L3:L,"<="&${mE}),206.95)`,
    ACCENT, PALE, DARK, DARK, 11, false);

  // Row 10: Total Spent — excludes Cash Withdrawals
  sRow(10, 'Total Spent',
    `=IFERROR(SUMIFS(M3:M,L3:L,">="&${mS},L3:L,"<="&${mE},N3:N,"<>Cash Withdrawal"),0)`,
    ACCENT, REDBG, DARK, RED, 13, true);

  // Row 11: Budget Remaining
  totalRow(11, '= Budget Remaining', '=D8-D10', DARK, DARK);

  divRow(12);

  // Row 13: Necessary
  sheet.setRowHeight(13, 26);
  sheet.getRange(13, 1, 1, 3).clearContent().clearFormat();
  sheet.getRange(13, 4, 1, 2).clearContent().clearFormat();
  sheet.getRange(13, 1, 1, 3).merge()
    .setValue('✅ Necessary').setBackground(GREENBG).setFontColor(GREEN)
    .setFontFamily('Arial').setFontSize(10).setFontWeight('bold')
    .setHorizontalAlignment('center').setVerticalAlignment('middle');
  sheet.getRange(13, 4, 1, 2).merge()
    .setFormula(`=IFERROR(SUMIFS(M3:M,P3:P,"Necessary",L3:L,">="&${mS},L3:L,"<="&${mE},N3:N,"<>Cash Withdrawal"),0)`)
    .setBackground(GREENBG).setFontColor(GREEN)
    .setFontFamily('Arial').setFontSize(11).setFontWeight('bold')
    .setNumberFormat('£#,##0.00')
    .setHorizontalAlignment('left').setVerticalAlignment('middle');

  // Row 14: Semi-necessary
  sheet.setRowHeight(14, 26);
  sheet.getRange(14, 1, 1, 3).clearContent().clearFormat();
  sheet.getRange(14, 4, 1, 2).clearContent().clearFormat();
  sheet.getRange(14, 1, 1, 3).merge()
    .setValue('〰️ Semi-necessary').setBackground('#FFF9C4').setFontColor('#827717')
    .setFontFamily('Arial').setFontSize(10).setFontWeight('bold')
    .setHorizontalAlignment('center').setVerticalAlignment('middle');
  sheet.getRange(14, 4, 1, 2).merge()
    .setFormula(`=IFERROR(SUMIFS(M3:M,P3:P,"Semi-necessary",L3:L,">="&${mS},L3:L,"<="&${mE}),0)`)
    .setBackground('#FFF9C4').setFontColor('#827717')
    .setFontFamily('Arial').setFontSize(11).setFontWeight('bold')
    .setNumberFormat('£#,##0.00')
    .setHorizontalAlignment('left').setVerticalAlignment('middle');

  // Row 15: Discretionary
  sheet.setRowHeight(15, 26);
  sheet.getRange(15, 1, 1, 3).clearContent().clearFormat();
  sheet.getRange(15, 4, 1, 2).clearContent().clearFormat();
  sheet.getRange(15, 1, 1, 3).merge()
    .setValue('❌ Discretionary').setBackground(REDBG).setFontColor(RED)
    .setFontFamily('Arial').setFontSize(10).setFontWeight('bold')
    .setHorizontalAlignment('center').setVerticalAlignment('middle');
  sheet.getRange(15, 4, 1, 2).merge()
    .setFormula(`=IFERROR(SUMIFS(M3:M,P3:P,"Discretionary",L3:L,">="&${mS},L3:L,"<="&${mE}),0)`)
    .setBackground(REDBG).setFontColor(RED)
    .setFontFamily('Arial').setFontSize(11).setFontWeight('bold')
    .setNumberFormat('£#,##0.00')
    .setHorizontalAlignment('left').setVerticalAlignment('middle');

  // Row 16: Top Category
  sheet.setRowHeight(16, 26);
  sheet.getRange(16, 1, 1, 3).clearContent().clearFormat();
  sheet.getRange(16, 4, 1, 2).clearContent().clearFormat();
  sheet.getRange(16, 1, 1, 3).merge()
    .setValue('🏆 Top Category').setBackground(ACCENT).setFontColor(DARK)
    .setFontFamily('Arial').setFontSize(10).setFontWeight('bold')
    .setHorizontalAlignment('center').setVerticalAlignment('middle');
  sheet.getRange(16, 4, 1, 2).merge()
    .setFormula(`=IFERROR(INDEX(N3:N,MATCH(MAXIFS(M3:M,L3:L,">="&${mS},L3:L,"<="&${mE},N3:N,"<>Cash Withdrawal"),M3:M,0)),"—")`)
    .setBackground(ACCENT).setFontColor(DARK)
    .setFontFamily('Arial').setFontSize(11).setFontWeight('bold')
    .setHorizontalAlignment('left').setVerticalAlignment('middle');

  divRow(17);

  // Row 18: Total Saved
  sheet.setRowHeight(18, 28);
  sheet.getRange(18, 1, 1, 3).clearContent().clearFormat();
  sheet.getRange(18, 4, 1, 2).clearContent().clearFormat();
  sheet.getRange(18, 1, 1, 3).merge()
    .setValue('💰 Total Saved').setBackground(DARK).setFontColor(WHITE)
    .setFontFamily('Arial').setFontSize(10).setFontWeight('bold')
    .setHorizontalAlignment('right').setVerticalAlignment('middle');
  sheet.getRange(18, 4, 1, 2).merge()
    .setFormula('=IFERROR(SUM(AC3:AC),0)')
    .setBackground(DARK).setFontColor(WHITE)
    .setFontFamily('Arial').setFontSize(13).setFontWeight('bold')
    .setNumberFormat('£#,##0.00')
    .setHorizontalAlignment('left').setVerticalAlignment('middle');

  // ═══════════════════════════════════════════════════════════════
  // GAP + CODEX — Rows 19 onwards, Columns A–E
  // ═══════════════════════════════════════════════════════════════
  sheet.setRowHeight(19, 16);
  sheet.getRange(19, 1, 1, 5).setBackground(ACCENT);

  function cRow(row, span, text, bg, fc, size, bold, italic) {
    sheet.setRowHeight(row, 24);
    const r = sheet.getRange(row, 1, 1, span);
    if (span > 1) r.merge();
    r.setValue(text).setBackground(bg).setFontColor(fc || WHITE)
      .setFontFamily('Arial').setFontSize(size || 9)
      .setFontWeight(bold ? 'bold' : 'normal')
      .setFontStyle(italic ? 'italic' : 'normal')
      .setHorizontalAlignment('center').setVerticalAlignment('middle')
      .setWrap(true);
  }

  cRow(20, 5, 'MONEY REFERENCE GUIDE', DARK, WHITE, 11, true);
  cRow(21, 5, 'NECESSITY TIERS', MID, WHITE, 10, true);

  const tiers = [
    ['✅ Necessary','Bills, petrol, groceries — no real choice','C8E6C9','1B5E20'],
    ['〰️ Semi','Needed but reducible — convenience, extras','FFF9C4','827717'],
    ['❌ Discretionary','Pure choice — nights out, shopping','FFCDD2','B71C1C'],
  ];
  tiers.forEach(([label, desc, bg, fc], i) => {
    const row = 22 + (i * 2);
    sheet.setRowHeight(row, 22); sheet.setRowHeight(row+1, 26);
    sheet.getRange(row, 1, 1, 5).merge().setValue(label)
      .setBackground('#'+bg).setFontColor('#'+fc)
      .setFontFamily('Arial').setFontSize(10).setFontWeight('bold')
      .setHorizontalAlignment('center').setVerticalAlignment('middle');
    sheet.getRange(row+1, 1, 1, 5).merge().setValue(desc)
      .setBackground('#'+bg).setFontColor('#'+fc)
      .setFontFamily('Arial').setFontSize(9)
      .setHorizontalAlignment('left').setVerticalAlignment('middle').setWrap(true);
  });

  cRow(29, 5, 'MOOD AT PURCHASE', MID, WHITE, 10, true);
  const moods = [
    ['1–2','Emotional — low, anxious, bored','FFCDD2','B71C1C'],
    ['3–4','Impulsive — slight guilt','FFCCBC','7A1E00'],
    ['5–6','Neutral — felt okay','FFF9C4','827717'],
    ['7–8','Considered — felt good','C8E6C9','1B5E20'],
    ['9–10','Intentional — no guilt','4A7C59','FFFFFF'],
  ];
  moods.forEach(([score, desc, bg, fc], i) => {
    const row = 30 + i; sheet.setRowHeight(row, 24);
    sheet.getRange(row, 1, 1, 2).merge().setValue(score)
      .setBackground('#'+bg).setFontColor('#'+fc)
      .setFontFamily('Arial').setFontSize(10).setFontWeight('bold')
      .setHorizontalAlignment('center').setVerticalAlignment('middle');
    sheet.getRange(row, 3, 1, 3).merge().setValue(desc)
      .setBackground('#'+bg).setFontColor('#'+fc)
      .setFontFamily('Arial').setFontSize(9)
      .setHorizontalAlignment('left').setVerticalAlignment('middle');
  });

  cRow(36, 5, 'CATEGORY GUIDE', MID, WHITE, 10, true);
  const cats = [
    ['Groceries','Food shopping, supermarket'],
    ['Eating Out','Restaurants, cafes, takeaway, coffee'],
    ['Transport','Petrol, Uber, TfL, parking — auto Card'],
    ['Bills','Phone £10 · Gym £26.95 · StepChange £170'],
    ['Gas & Electric','Pay-as-you-go top-ups'],
    ['Family','Money to mum, sister, family'],
    ['Personal Care','Hair, nails, skincare'],
    ['Shopping','Clothes, home, random'],
    ['Entertainment','Nights out, events, cinema'],
    ['Health','Pharmacy, appointments'],
    ['Subscriptions','Netflix, Spotify, apps'],
    ['Cash Withdrawal','ATM — not counted as spending'],
    ['Other','Anything else'],
  ];
  cats.forEach(([cat, desc], i) => {
    const row = 37 + i; sheet.setRowHeight(row, 22);
    const bg = i % 2 === 0 ? PALE : CREAM;
    sheet.getRange(row, 1, 1, 2).merge().setValue(cat)
      .setBackground(ACCENT).setFontColor(DARK)
      .setFontFamily('Arial').setFontSize(9).setFontWeight('bold')
      .setHorizontalAlignment('left').setVerticalAlignment('middle');
    sheet.getRange(row, 3, 1, 3).merge().setValue(desc)
      .setBackground(bg).setFontColor(DARK)
      .setFontFamily('Arial').setFontSize(9)
      .setHorizontalAlignment('left').setVerticalAlignment('middle');
  });

  cRow(51, 5, 'THE 50% RULE', MID, WHITE, 10, true);
  cRow(52, 5, 'Total spending ≤ 50% of gross income. Cash Withdrawals excluded.', ACCENT, DARK, 9, false, false);
  cRow(53, 5, 'Refunds = negative amount in spending log, same category.', ACCENT, DARK, 9, false, true);
  cRow(54, 5, 'Fixed: Phone £10 · Gym £26.95 · StepChange £170 = £206.95/month', PALE, DARK, 9, false, false);

  cRow(56, 5, 'SAVINGS POTS', MID, WHITE, 10, true);
  const potRef = [
    ['☔ Rainy Day','£500'],
    ['🚗 Car Emergency','£500'],
    ['🌱 General','£1,500'],
    ['🏠 House Fund','£10,000'],
    ['🚘 New Car','£10,000'],
    ['🐾 Pet Emergency','£500'],
    ['🇰🇷 Korean Account','No target'],
  ];
  potRef.forEach(([pot, target], i) => {
    const row = 57 + i; sheet.setRowHeight(row, 22);
    const bg = i % 2 === 0 ? PALE : CREAM;
    sheet.getRange(row, 1, 1, 3).merge().setValue(pot)
      .setBackground(ACCENT).setFontColor(DARK)
      .setFontFamily('Arial').setFontSize(9).setFontWeight('bold')
      .setHorizontalAlignment('left').setVerticalAlignment('middle');
    sheet.getRange(row, 4, 1, 2).merge().setValue(target)
      .setBackground(bg).setFontColor(DARK)
      .setFontFamily('Arial').setFontSize(9).setFontWeight('bold')
      .setHorizontalAlignment('center').setVerticalAlignment('middle');
  });

  cRow(65, 5, 'The Archive · Money · Year 1', DARK, WHITE, 9, false, true);

  // ═══════════════════════════════════════════════════════════════
  // DATA ROWS 3–1002
  // ═══════════════════════════════════════════════════════════════
  const dataRows = 1000;

  for (let i = 0; i < dataRows; i++) {
    const row = 3 + i;
    const bg = i % 2 === 0 ? PALE : CREAM;
    sheet.setRowHeight(row, 26);

    sheet.getRange(row, 7, 1, 4).setBackground(bg)
      .setHorizontalAlignment('center').setVerticalAlignment('middle');
    sheet.getRange(row, 8).setNumberFormat('£#,##0.00');
    sheet.getRange(row, 10).setHorizontalAlignment('left');

    sheet.getRange(row, 12, 1, 7).setBackground(bg)
      .setHorizontalAlignment('center').setVerticalAlignment('middle');
    sheet.getRange(row, 13).setNumberFormat('£#,##0.00');
    sheet.getRange(row, 15).setHorizontalAlignment('left');

    sheet.getRange(row, 27, 1, 4).setBackground(bg)
      .setHorizontalAlignment('center').setVerticalAlignment('middle');
    sheet.getRange(row, 29).setNumberFormat('£#,##0.00');
    sheet.getRange(row, 30).setHorizontalAlignment('left');
  }

  // Date formats
  sheet.getRange(3, 7, dataRows, 1)
    .setNumberFormat('dd/mm/yyyy').setBackground(ACCENT)
    .setFontColor(DARK).setFontWeight('bold');
  sheet.getRange(3, 12, dataRows, 1)
    .setNumberFormat('dd/mm/yyyy').setBackground(ACCENT)
    .setFontColor(DARK).setFontWeight('bold');
  sheet.getRange(3, 27, dataRows, 1)
    .setNumberFormat('dd/mm/yyyy').setBackground(ACCENT)
    .setFontColor(DARK).setFontWeight('bold');

  // ── DATA VALIDATION ──────────────────────────────────────────────

  // Income amount H
  sheet.getRange(3, 8, dataRows, 1).setDataValidation(
    SpreadsheetApp.newDataValidation()
      .requireNumberGreaterThan(0).setAllowInvalid(false).build());

  // Income source I — added Bank Interest, Cashback, Refund
  sheet.getRange(3, 9, dataRows, 1).setDataValidation(
    SpreadsheetApp.newDataValidation()
      .requireValueInList([
        'Salary / PAYE','Freelance','Resale (Vinted/eBay)',
        'Cash in Hand','Bank Interest','Cashback',
        'Gift','Other'
      ], true).setAllowInvalid(false).build());

  // Spending amount M — allows negative for refunds
  sheet.getRange(3, 13, dataRows, 1).setDataValidation(
    SpreadsheetApp.newDataValidation()
      .requireFormulaSatisfied('=AND(ISNUMBER(M3),M3<>0)')
      .setAllowInvalid(false)
      .setHelpText('Enter amount. Use negative for refunds e.g. -15.00').build());

  // Spending category N — added Cash Withdrawal
  sheet.getRange(3, 14, dataRows, 1).setDataValidation(
    SpreadsheetApp.newDataValidation()
      .requireValueInList([
        'Groceries','Eating Out','Transport','Bills',
        'Gas & Electric','Family','Personal Care','Shopping',
        'Entertainment','Health','Subscriptions',
        'Cash Withdrawal','Other'
      ], true).setAllowInvalid(false).build());

  // Spending necessity P
  sheet.getRange(3, 16, dataRows, 1).setDataValidation(
    SpreadsheetApp.newDataValidation()
      .requireValueInList(['Necessary','Semi-necessary','Discretionary'], true)
      .setAllowInvalid(false).build());

  // Spending payment Q
  sheet.getRange(3, 17, dataRows, 1).setDataValidation(
    SpreadsheetApp.newDataValidation()
      .requireValueInList(['Card','Cash','Bank Transfer','Direct Debit'], true)
      .setAllowInvalid(false).build());

  // Spending mood R
  sheet.getRange(3, 18, dataRows, 1).setDataValidation(
    SpreadsheetApp.newDataValidation()
      .requireFormulaSatisfied('=OR(R3="",AND(ISNUMBER(R3),R3>=1,R3<=10))')
      .setAllowInvalid(false)
      .setHelpText('1–10 or leave blank for Cash Withdrawals').build());

  // Deposit pot AB
  sheet.getRange(3, 28, dataRows, 1).setDataValidation(
    SpreadsheetApp.newDataValidation()
      .requireValueInList([
        '☔ Rainy Day','🚗 Car Emergency','🌱 General',
        '🏠 House Fund','🚘 New Car','🐾 Pet Emergency',
        '🇰🇷 Korean Account'
      ], true).setAllowInvalid(false).build());

  // Deposit amount AC
  sheet.getRange(3, 29, dataRows, 1).setDataValidation(
    SpreadsheetApp.newDataValidation()
      .requireNumberGreaterThan(0).setAllowInvalid(false).build());

  // ═══════════════════════════════════════════════════════════════
  // SAVINGS TRACKER — Rows 3–9, Columns T–Y (20–25)
  // 7 pots — Korean Account has no target
  // ═══════════════════════════════════════════════════════════════
  const pots = [
    { name: '☔ Rainy Day',       target: 500,   color: '4A90D9' },
    { name: '🚗 Car Emergency',   target: 500,   color: 'E8A045' },
    { name: '🌱 General',         target: 1500,  color: '4A7C59' },
    { name: '🏠 House Fund',      target: 10000, color: '8B6914' },
    { name: '🚘 New Car',         target: 10000, color: '003049' },
    { name: '🐾 Pet Emergency',   target: 500,   color: '780000' },
    { name: '🇰🇷 Korean Account', target: null,  color: '1D4E63' },
  ];

  pots.forEach(({ name, target, color }, i) => {
    const row = 3 + i;
    sheet.setRowHeight(row, 30);

    sheet.getRange(row, 20).setValue(name)
      .setBackground('#'+color).setFontColor(WHITE)
      .setFontSize(10).setFontWeight('bold')
      .setHorizontalAlignment('left').setVerticalAlignment('middle');

    // Target — blank if no target
    sheet.getRange(row, 21)
      .setValue(target !== null ? target : '')
      .setBackground(ACCENT).setFontColor(DARK)
      .setFontSize(10).setFontWeight('bold')
      .setNumberFormat(target !== null ? '£#,##0.00' : '@')
      .setHorizontalAlignment('center').setVerticalAlignment('middle');

    // Saved — auto-sums from deposit log
    sheet.getRange(row, 22)
      .setFormula(`=IFERROR(SUMIF(AB3:AB,"${name}",AC3:AC),0)`)
      .setBackground(GREENBG).setFontColor(GREEN)
      .setFontSize(10).setFontWeight('bold')
      .setNumberFormat('£#,##0.00')
      .setHorizontalAlignment('center').setVerticalAlignment('middle');

    // Remaining
    if (target !== null) {
      sheet.getRange(row, 23)
        .setFormula(`=MAX(U${row}-V${row},0)`)
        .setBackground(PALE).setFontColor(RED)
        .setFontSize(10).setFontWeight('bold')
        .setNumberFormat('£#,##0.00')
        .setHorizontalAlignment('center').setVerticalAlignment('middle');
    } else {
      sheet.getRange(row, 23).setValue('No target')
        .setBackground(PALE).setFontColor('#888888')
        .setFontSize(9).setFontStyle('italic')
        .setHorizontalAlignment('center').setVerticalAlignment('middle');
    }

    // % done
    if (target !== null) {
      sheet.getRange(row, 24)
        .setFormula(`=IFERROR(ROUND(V${row}/U${row}*100,1)&"%","0%")`)
        .setBackground(PALE).setFontColor(GREEN)
        .setFontSize(10).setFontWeight('bold')
        .setHorizontalAlignment('center').setVerticalAlignment('middle');
    } else {
      sheet.getRange(row, 24).setValue('—')
        .setBackground(PALE).setFontColor('#888888')
        .setFontSize(9)
        .setHorizontalAlignment('center').setVerticalAlignment('middle');
    }

    // Progress bar
    if (target !== null) {
      sheet.getRange(row, 25)
        .setFormula(
          `=REPT("█",ROUND(V${row}/U${row}*20,0))&` +
          `REPT("░",20-ROUND(V${row}/U${row}*20,0))`
        )
        .setBackground('#'+color).setFontColor(WHITE)
        .setFontSize(9).setHorizontalAlignment('left').setVerticalAlignment('middle');
    } else {
      sheet.getRange(row, 25)
        .setFormula(`=REPT("█",MIN(ROUND(V${row}/500*20,0),20))`)
        .setBackground('#'+color).setFontColor(WHITE)
        .setFontSize(9).setHorizontalAlignment('left').setVerticalAlignment('middle');
    }
  });

  // Savings total row (row 10)
  sheet.setRowHeight(10, 28);
  sheet.getRange(10, 20, 1, 2).merge()
    .setValue('TOTAL SAVED').setBackground(DARK).setFontColor(WHITE)
    .setFontSize(10).setFontWeight('bold')
    .setHorizontalAlignment('right').setVerticalAlignment('middle');
  sheet.getRange(10, 22)
    .setFormula('=SUM(V3:V9)')
    .setBackground(DARK).setFontColor(WHITE)
    .setFontSize(11).setFontWeight('bold')
    .setNumberFormat('£#,##0.00')
    .setHorizontalAlignment('center').setVerticalAlignment('middle');
  sheet.getRange(10, 23, 1, 3).merge()
    .setFormula('=IFERROR(ROUND(SUM(V3:V9)/SUMIF(U3:U9,">"&0)*100,1)&"% of targets with set amounts","—")')
    .setBackground(DARK).setFontColor(WHITE)
    .setFontSize(9).setFontWeight('bold')
    .setHorizontalAlignment('center').setVerticalAlignment('middle');

  // ── GAP ROW 11 ────────────────────────────────────────────────────
  sheet.setRowHeight(11, 12);
  sheet.getRange(11, 20, 1, 6).setBackground(ACCENT);

  // ═══════════════════════════════════════════════════════════════
  // CASH TRACKER — Rows 12–17, Columns T–Y
  // ═══════════════════════════════════════════════════════════════

  // Row 12: Cash tracker header
  sheet.setRowHeight(12, 32);
  sheet.getRange(12, 20, 1, 6).merge()
    .setValue('💵 CASH TRACKER')
    .setBackground(DARK).setFontColor(WHITE)
    .setFontFamily('Arial').setFontSize(11).setFontWeight('bold')
    .setHorizontalAlignment('center').setVerticalAlignment('middle');

  // Cash tracker rows helper
  function cashRow(row, label, formula, lBg, vBg, lFc, vFc) {
    sheet.setRowHeight(row, 26);
    sheet.getRange(row, 20, 1, 3).merge()
      .setValue(label)
      .setBackground(lBg || ACCENT).setFontColor(lFc || DARK)
      .setFontFamily('Arial').setFontSize(10).setFontWeight('bold')
      .setHorizontalAlignment('right').setVerticalAlignment('middle');
    sheet.getRange(row, 23, 1, 3).merge()
      .setFormula(formula)
      .setBackground(vBg || PALE).setFontColor(vFc || DARK)
      .setFontFamily('Arial').setFontSize(12).setFontWeight('bold')
      .setNumberFormat('£#,##0.00')
      .setHorizontalAlignment('left').setVerticalAlignment('middle');
  }

  // Row 13: Cash withdrawn this month (Category = Cash Withdrawal)
  cashRow(13, 'Withdrawn this month',
    `=IFERROR(SUMIFS(M3:M,N3:N,"Cash Withdrawal",L3:L,">="&${mS},L3:L,"<="&${mE}),0)`,
    ACCENT, PALE, DARK, DARK);

  // Row 14: Cash spent this month (Payment = Cash, excl withdrawals)
  cashRow(14, 'Spent in cash',
    `=IFERROR(SUMIFS(M3:M,Q3:Q,"Cash",L3:L,">="&${mS},L3:L,"<="&${mE},N3:N,"<>Cash Withdrawal"),0)`,
    ACCENT, REDBG, DARK, RED);

  // Row 15: Estimated cash on hand
  sheet.setRowHeight(15, 30);
  sheet.getRange(15, 20, 1, 3).merge()
    .setValue('Est. Cash on Hand')
    .setBackground(DARK).setFontColor(WHITE)
    .setFontFamily('Arial').setFontSize(10).setFontWeight('bold')
    .setHorizontalAlignment('right').setVerticalAlignment('middle');
  sheet.getRange(15, 23, 1, 3).merge()
    .setFormula(`=IFERROR(SUMIFS(M3:M,N3:N,"Cash Withdrawal",L3:L,">="&${mS},L3:L,"<="&${mE})-SUMIFS(M3:M,Q3:Q,"Cash",L3:L,">="&${mS},L3:L,"<="&${mE},N3:N,"<>Cash Withdrawal"),0)`)
    .setBackground(DARK).setFontColor(WHITE)
    .setFontFamily('Arial').setFontSize(14).setFontWeight('bold')
    .setNumberFormat('£#,##0.00')
    .setHorizontalAlignment('left').setVerticalAlignment('middle');

  // Row 16: divider
  sheet.setRowHeight(16, 6);
  sheet.getRange(16, 20, 1, 6).setBackground(ACCENT);

  // Row 17: helper note
  sheet.setRowHeight(17, 30);
  sheet.getRange(17, 20, 1, 6).merge()
    .setValue('Log ATM trips as Category: Cash Withdrawal · Payment: Card\nLog cash purchases normally with Payment: Cash')
    .setBackground(PALE).setFontColor(DARK)
    .setFontFamily('Arial').setFontSize(8).setFontStyle('italic')
    .setHorizontalAlignment('center').setVerticalAlignment('middle')
    .setWrap(true);

  // ── CONDITIONAL FORMATTING ───────────────────────────────────────
  const sheetId = sheet.getSheetId();
  const cfEnd = 3 + dataRows;

  Sheets.Spreadsheets.batchUpdate({ requests: [

    // Mood gradient col R (17)
    { addConditionalFormatRule: { rule: {
      ranges: [{ sheetId, startRowIndex: 2, endRowIndex: cfEnd,
                 startColumnIndex: 17, endColumnIndex: 18 }],
      gradientRule: {
        minpoint: { color: hexToColor('FFCDD2'), type: 'NUMBER', value: '1' },
        midpoint: { color: hexToColor('FFF9C4'), type: 'NUMBER', value: '5' },
        maxpoint: { color: hexToColor('C8E6C9'), type: 'NUMBER', value: '10' }
      }
    }, index: 0 } },

    // Necessity: Necessary = green
    { addConditionalFormatRule: { rule: {
      ranges: [{ sheetId, startRowIndex: 2, endRowIndex: cfEnd,
                 startColumnIndex: 15, endColumnIndex: 16 }],
      booleanRule: {
        condition: { type: 'TEXT_EQ', values: [{ userEnteredValue: 'Necessary' }] },
        format: { backgroundColor: hexToColor('C8E6C9'),
                  textFormat: { foregroundColor: hexToColor('1B5E20'), bold: true } }
      }
    }, index: 0 } },

    // Necessity: Semi = amber
    { addConditionalFormatRule: { rule: {
      ranges: [{ sheetId, startRowIndex: 2, endRowIndex: cfEnd,
                 startColumnIndex: 15, endColumnIndex: 16 }],
      booleanRule: {
        condition: { type: 'TEXT_EQ', values: [{ userEnteredValue: 'Semi-necessary' }] },
        format: { backgroundColor: hexToColor('FFF9C4'),
                  textFormat: { foregroundColor: hexToColor('827717') } }
      }
    }, index: 0 } },

    // Necessity: Discretionary = red
    { addConditionalFormatRule: { rule: {
      ranges: [{ sheetId, startRowIndex: 2, endRowIndex: cfEnd,
                 startColumnIndex: 15, endColumnIndex: 16 }],
      booleanRule: {
        condition: { type: 'TEXT_EQ', values: [{ userEnteredValue: 'Discretionary' }] },
        format: { backgroundColor: hexToColor('FFCDD2'),
                  textFormat: { foregroundColor: hexToColor('B71C1C') } }
      }
    }, index: 0 } },

    // Amount gradient col M (12) — negative = green (refund), positive = gold
    { addConditionalFormatRule: { rule: {
      ranges: [{ sheetId, startRowIndex: 2, endRowIndex: cfEnd,
                 startColumnIndex: 12, endColumnIndex: 13 }],
      gradientRule: {
        minpoint: { color: hexToColor('C8E6C9'), type: 'NUMBER', value: '-50' },
        midpoint: { color: hexToColor('FFFBF0'), type: 'NUMBER', value: '0' },
        maxpoint: { color: hexToColor('8B6914'), type: 'NUMBER', value: '200' }
      }
    }, index: 0 } },

    // Cash Withdrawal category — grey highlight
    { addConditionalFormatRule: { rule: {
      ranges: [{ sheetId, startRowIndex: 2, endRowIndex: cfEnd,
                 startColumnIndex: 11, endColumnIndex: 18 }],
      booleanRule: {
        condition: { type: 'CUSTOM_FORMULA',
          values: [{ userEnteredValue: '=$N3="Cash Withdrawal"' }] },
        format: { backgroundColor: hexToColor('ECEFF1'),
                  textFormat: { foregroundColor: hexToColor('607D8B') } }
      }
    }, index: 0 } },

  ]}, ss.getId());

  Logger.log('✅ Money tab built successfully!');
}


