// AUTO-DATE + AUTO-SORT + AUTO-WRITE TO MONEY TAB
// ═══════════════════════════════════════════════════════════════════
function autoFillLifeAndCultureDate(e) {
  const sheet = e.range.getSheet();
  if (sheet.getName() !== 'Life & Culture') return;

  const ss = e.source;
  const row = e.range.getRow();
  const col = e.range.getColumn();
  if (row < 3) return;

  // Auto-date: any entry in cols B–H → fill date in col A
  if (col >= 2 && col <= 8) {
    const dateCell = sheet.getRange(row, 1);
    if (dateCell.getValue() === '') {
      dateCell.setValue(new Date()).setNumberFormat('dd/mm/yyyy');
    }
  }

  // Auto-write cost to Money tab when cost (col G) is entered
  if (col === 7) {
    const cost = e.value;
    if (cost && parseFloat(cost) > 0) {
      const moneySheet = ss.getSheetByName('Money');
      if (moneySheet) {
        const placeName = sheet.getRange(row, 3).getValue() || 'Life & Culture outing';
        const outingDate = sheet.getRange(row, 1).getValue();

        // Find first empty row in Money spending log (col L)
        const moneyData = moneySheet.getRange(3, 12, 1000, 1).getValues();
        let firstEmpty = 3;
        for (let i = 0; i < moneyData.length; i++) {
          if (moneyData[i][0] === '') { firstEmpty = 3 + i; break; }
        }

        // Write to Money spending log
        // L=date, M=amount, N=category, O=description, P=necessity, Q=payment
        moneySheet.getRange(firstEmpty, 12).setValue(outingDate || new Date())
          .setNumberFormat('dd/mm/yyyy');
        moneySheet.getRange(firstEmpty, 13).setValue(parseFloat(cost))
          .setNumberFormat('£#,##0.00');
        moneySheet.getRange(firstEmpty, 14).setValue('Life & Culture');
        moneySheet.getRange(firstEmpty, 15).setValue(placeName);
        moneySheet.getRange(firstEmpty, 16).setValue('Necessary');
        moneySheet.getRange(firstEmpty, 17).setValue('Card');

        // Trigger sort on Money spending log
        const lastMoneyRow = moneySheet.getLastRow();
        if (lastMoneyRow > 3) {
          moneySheet.getRange(3, 12, lastMoneyRow - 2, 7)
            .sort({ column: 12, ascending: true });
        }
      }
    }
  }

  // Auto-sort Life & Culture log by date
  if (col >= 1 && col <= 8) {
    const lastRow = sheet.getLastRow();
    if (lastRow > 3) {
      sheet.getRange(3, 1, lastRow - 2, 8)
        .sort({ column: 1, ascending: true });
    }
  }
}


